<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is permitted at the platform level only so users can reach
     model/MCP servers they run on their own LAN or device. Sherpa's own
     UrlPolicy (packages/sherpa_net) still refuses plain http for anything
     that is not loopback or a private-network address the user added. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
