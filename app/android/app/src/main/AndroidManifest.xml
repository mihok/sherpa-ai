<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Dictation in the composer (asked on first use; on-device recognition preferred). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Background runs ("Keep working in the background"): sherpa_platform's
         RunService. Its manifest already declares these; repeated here so the
         app's own manifest says what it asks for. shortService (finish a
         reply, ~3 min) needs no type permission; specialUse (agent runs) does.
         POST_NOTIFICATIONS is asked at runtime on API 33+, from the chat,
         after saying why. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:label="Sherpa"
        android:enableOnBackInvokedCallback="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- "Add this tool server" links: sherpa://mcp/add?url=…
                 Routed by Flutter's deep linking to go_router, which always
                 shows a confirmation; nothing is added automatically. The
                 scheme differs from the OAuth redirect scheme on purpose. -->
            <meta-data android:name="flutter_deeplinking_enabled" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sherpa" android:host="mcp" android:pathPrefix="/add" />
            </intent-filter>
        </activity>
        <!-- OAuth redirect (io.github.mihok.sherpa:/oauth/callback) for MCP
             servers and Hugging Face, when the browser falls back from Auth
             Tab to a Custom Tab (flutter_web_auth_2). -->
        <activity
            android:name="com.linusu.flutter_web_auth_2.CallbackActivity"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter android:label="flutter_web_auth_2">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="io.github.mihok.sherpa" />
            </intent-filter>
        </activity>
        <!-- The foreground service that keeps a reply or agent run alive after
             the user leaves (started only while Sherpa is visible). The plugin
             declares it with foregroundServiceType="shortService|specialUse"
             (not repeated here: the merger would concatenate the flags). The
             specialUse subtype is what Google Play reviews (with the Play
             Console FGS declaration and a video, R07 §4.1); it replaces the
             plugin's default, which names on-device inference only, because
             the service also covers tool calls and requests to the model
             provider the user chose. -->
        <service
            android:name="io.github.mihok.sherpa_platform.RunService"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Finishes an AI agent task the user started in the app (on-device model inference, tool calls and requests to the model provider the user chose) after the user leaves the app"
                tools:replace="android:value" />
        </service>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Android 11+ package visibility: lets url_launcher find a Custom
             Tabs browser for links and URL elicitation (otherwise it opens
             the browser app, never an in-app WebView). -->
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService"/>
        </intent>
        <!-- Android 11+ package visibility: lets speech_to_text find the system
             speech recognizer for dictation. -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
    </queries>
</manifest>
