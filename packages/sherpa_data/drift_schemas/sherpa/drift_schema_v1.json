  "fixed_sql": [
    {
      "name": "sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sessions\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"provider_id\" TEXT NULL, \"model_id\" TEXT NULL, \"active_leaf_id\" TEXT NULL, \"system_prompt\" TEXT NULL, \"handoff_from\" TEXT NULL, \"archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"archived\" IN (0, 1)), \"settings_json\" TEXT NOT NULL DEFAULT '{}', PRIMARY KEY (\"id\")) STRICT;"
        }
      ]
    },
    {
      "name": "audit",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"audit\" (\"seq\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"session_id\" TEXT NOT NULL REFERENCES sessions (id) ON DELETE CASCADE, \"id\" TEXT NOT NULL, \"at\" INTEGER NOT NULL, \"kind\" TEXT NOT NULL, \"summary\" TEXT NOT NULL, \"json\" TEXT NOT NULL, UNIQUE (\"session_id\", \"id\")) STRICT;"
        }
      ]
    },
    {
      "name": "audit_append_only",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TRIGGER audit_append_only BEFORE UPDATE ON audit BEGIN SELECT RAISE (ABORT, 'audit is append-only');END"
        }
      ]
    },
    {
      "name": "messages",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"messages\" (\"session_id\" TEXT NOT NULL REFERENCES sessions (id) ON DELETE CASCADE, \"id\" TEXT NOT NULL, \"parent_id\" TEXT NULL, \"role\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"pinned\" INTEGER NOT NULL DEFAULT 0 CHECK (\"pinned\" IN (0, 1)), \"json\" TEXT NOT NULL, PRIMARY KEY (\"session_id\", \"id\")) STRICT;"
        }
      ]
    },
    {
      "name": "overlays",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"overlays\" (\"session_id\" TEXT NOT NULL REFERENCES sessions (id) ON DELETE CASCADE, \"id\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"json\" TEXT NOT NULL, PRIMARY KEY (\"session_id\", \"id\")) STRICT;"
        }
      ]
    },
    {
      "name": "plans",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"plans\" (\"session_id\" TEXT NOT NULL REFERENCES sessions (id) ON DELETE CASCADE, \"updated_at\" INTEGER NOT NULL, \"json\" TEXT NOT NULL, PRIMARY KEY (\"session_id\")) STRICT;"
        }
      ]
    },
    {
      "name": "checkpoints",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"checkpoints\" (\"session_id\" TEXT NOT NULL REFERENCES sessions (id) ON DELETE CASCADE, \"run_id\" TEXT NOT NULL, \"phase\" TEXT NOT NULL, \"updated_at\" INTEGER NOT NULL, \"json\" TEXT NOT NULL, PRIMARY KEY (\"session_id\")) STRICT;"
        }
      ]
    },
    {
      "name": "documents",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"documents\" (\"collection\" TEXT NOT NULL, \"id\" TEXT NOT NULL, \"json\" TEXT NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"collection\", \"id\")) STRICT;"
        }
      ]
